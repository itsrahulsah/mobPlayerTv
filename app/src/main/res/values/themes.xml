<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobPlayerTv" parent="android:Theme.NoTitleBar.Fullscreen">
        <!-- Matches TvColors.BackgroundDark so no black flash shows between the splash and Compose -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
    </style>

    <!-- Launch theme: shown by the system while the process starts, swapped in MainActivity.onCreate -->
    <style name="Theme.MobPlayerTv.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MobPlayerTv</item>
    </style>
</resources>
